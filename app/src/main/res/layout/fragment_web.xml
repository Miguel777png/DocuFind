<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B0508"
    tools:context=".Fragments.WebFragment">

    <!-- Buscador de texto -->
    <EditText
        android:id="@+id/etBuscarWeb"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="#F5EBE0"
        android:hint="Buscar por nombre de archivo..."
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:textColor="#3B0A12"
        android:textColorHint="#7A5C55"
        app:layout_constraintEnd_toStartOf="@+id/btnBuscarWeb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón de lupa para buscar -->
    <ImageButton
        android:id="@+id/btnBuscarWeb"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#E3C5B5"
        android:src="@android:drawable/ic_menu_search"
        app:layout_constraintBottom_toBottomOf="@+id/etBuscarWeb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/etBuscarWeb"
        app:tint="#3B0A12" />

    <!-- Filtro por Categoría -->
    <Spinner
        android:id="@+id/spinnerFiltroCategoria"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="#E3C5B5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etBuscarWeb" />

    <!-- Lista de resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewWebDocs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinnerFiltroCategoria" />

</androidx.constraintlayout.widget.ConstraintLayout>