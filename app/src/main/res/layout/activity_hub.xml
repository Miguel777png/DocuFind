<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7F3030">

    <!-- Tarjeta Principal de Contenido -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Logo de la App -->
            <ImageView
                android:id="@+id/imgHubLogo"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="Logo DocuFind"
                android:src="@drawable/images_2" />

            <!-- Título del Proyecto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DocuFind"
                android:textColor="#7F3030"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtítulo Informativo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Red social y repositorio colaborativo para documentación de estudio."
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <!-- Separador -->
            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginVertical="24dp"
                android:background="#E5E7EB" />

            <!-- Botón 1: Iniciar Sesión -->
            <Button
                android:id="@+id/btnHubLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#7F3030"
                android:text="Iniciar Sesión"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <!-- Botón 2: Registrarse -->
            <Button
                android:id="@+id/btnHubRegister"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Crear Cuenta"
                android:textColor="#7F3030"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#7F3030"
                app:strokeWidth="1.5dp" />

            <!-- Botón 3: Salir -->
            <Button
                android:id="@+id/btnHubSalir"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Salir de la aplicación"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>