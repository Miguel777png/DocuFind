<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B0508"
    tools:context=".Fragments.HomeFragment">

    <!-- Tarjeta de Creación de Publicación -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCrearPublicacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        app:cardBackgroundColor="#3D1016"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Encabezado de la Tarjeta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Nueva Publicación"
                android:textColor="#E3C5B5"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Campo de Texto Principal -->
            <EditText
                android:id="@+id/etMensajePublicacion"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="#4E1A22"
                android:gravity="top|start"
                android:hint="¿Qué documento o foto quieres compartir hoy?"
                android:inputType="textLongMessage|textMultiLine"
                android:padding="12dp"
                android:textColor="#F5EBE0"
                android:textColorHint="#A88B83"
                android:textSize="14sp" />

            <!-- Fila de Botones Adjuntos (PDF / Cámara) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAdjuntarPdf"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E3C5B5"
                    android:text="📄 Adjuntar PDF"
                    android:textColor="#3B0A12"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnTomarFoto"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E3C5B5"
                    android:text="📷 Tomar Foto"
                    android:textColor="#3B0A12"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Spinner de Categoría para Creación -->
            <Spinner
                android:id="@+id/spinnerCategoria"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="#E3C5B5"
                android:paddingHorizontal="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Fila Cabecera: Título "Mis Archivos" + Spinner de Filtro Integrado -->
    <LinearLayout
        android:id="@+id/layoutHeaderFiltro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardCrearPublicacion">

        <TextView
            android:id="@+id/tvTituloMisArchivos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis Publicaciones"
            android:textColor="#E3C5B5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFiltroMisDocs"
            android:layout_width="160dp"
            android:layout_height="36dp"
            android:background="#E3C5B5"
            android:paddingHorizontal="6dp" />
    </LinearLayout>

    <!-- Listado RecyclerView de Publicaciones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMisDocs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderFiltro" />

    <!-- Botón Flotante para Confirmar Publicación -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSubirDoc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:backgroundTint="#E3C5B5"
        android:contentDescription="Publicar"
        android:src="@android:drawable/ic_menu_send"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#3B0A12" />

</androidx.constraintlayout.widget.ConstraintLayout>