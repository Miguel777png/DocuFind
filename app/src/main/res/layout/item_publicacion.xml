<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#3D1016"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Cabecera de la Publicación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPubAutor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre del Autor"
                android:textColor="#F5EBE0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnEditarPub"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Editar"
                android:src="@android:drawable/ic_menu_edit"
                android:visibility="gone"
                app:tint="#E3C5B5" />

            <ImageButton
                android:id="@+id/btnEliminarPub"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar"
                android:src="@android:drawable/ic_menu_delete"
                android:visibility="gone"
                app:tint="#E3C5B5" />
        </LinearLayout>

        <!-- Mensaje de la publicación -->
        <TextView
            android:id="@+id/textPubMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mensaje de la publicación..."
            android:textColor="#D1B4A5"
            android:textSize="14sp" />

        <!-- Imagen Destacada Completa (Vista estilo Catálogo / Red Social) -->
        <ImageView
            android:id="@+id/imgFotoFull"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Foto adjunta"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Contenedor de Documento PDF (Barra Rectangular Estándar) -->
        <LinearLayout
            android:id="@+id/layoutDocContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#4E1A22"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgDocPreview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Vista previa PDF"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#E3C5B5" />

            <TextView
                android:id="@+id/textPubDocNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="documento.pdf"
                android:textColor="#E3C5B5"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>