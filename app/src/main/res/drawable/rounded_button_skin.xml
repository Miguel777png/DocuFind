<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Color de fondo tipo piel / nude que combina con el rojo oscuro -->
    <solid android:color="#E3C5B5" />

    <!-- Esquinas redondeadas para que no sean rectángulos aburridos -->
    <corners android:radius="16dp" />

    <!-- Un pequeño margen interno (padding) simulado para dar grosor -->
    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp" />
</shape>